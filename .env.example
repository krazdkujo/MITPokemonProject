# Pokemon Educational Platform - Environment Variables
# Copy this file to .env.local and fill in your values
# Get Supabase credentials from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api

# =============================================================================
# SUPABASE CONFIGURATION (Required)
# =============================================================================

# Database password (for running migrations via npm run db:migrate)
# Found in: Project Settings > Database > Connection string > Password
SUPABASE=

# Your Supabase project URL
# Example: https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anonymous/public key (safe to expose in browser)
# Found in: Project Settings > API > Project API keys > anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key (KEEP SECRET - server-side only)
# Found in: Project Settings > API > Project API keys > service_role
# WARNING: This key bypasses Row Level Security - never expose to client
SUPABASE_SERVICE_KEY=

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# Enable test authentication screen (development only)
# Set to "true" to enable the /test-auth page
# WARNING: Never enable this in production!
NEXT_PUBLIC_ENABLE_TEST_AUTH=true
